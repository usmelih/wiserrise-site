---
import ContentLayout from '../../../layouts/ContentLayout.astro';
import CardGrid from '../../../components/CardGrid.astro';
import { routePath } from '../../../i18n/routes';

const locale = 'tr' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);

const guides = [
  {
    href: p('guides/not-showing'),
    icon: 'profile',
    title: 'İşletmem Google’da çıkmıyor',
    text: 'Sekiz olası sebebi sırayla eleyen bir teşhis akışı. Hangi kontrolü hangi sırayla yapacağınızı gösteriyor.',
  },
  {
    href: p('guides/create-profile'),
    icon: 'document',
    title: 'Google İşletme Profili nasıl açılır?',
    text: 'Sıfırdan kurulum. Adres gösterme kararı, kategori seçimi ve ilk gün yapılması gerekenler dahil.',
  },
  {
    href: p('guides/rank-higher'),
    icon: 'map',
    title: 'Google Haritalar’da üst sıraya çıkma',
    text: 'Sıralamayı belirleyen üç girdi, hangisini değiştirebileceğiniz ve hangi sırayla çalışmanız gerektiği.',
  },
  {
    href: p('guides/more-reviews'),
    icon: 'sparkle',
    title: 'Google yorumları nasıl artırılır?',
    text: 'Yorum istemenin doğru anı, filtreye takılmadan hacim büyütmek ve olumsuz yorumu yönetmek.',
  },
  {
    href: p('guides/verification'),
    icon: 'wrench',
    title: 'Profil doğrulama sorunları',
    text: 'Kart gelmedi, video doğrulama reddedildi, profil askıya alındı — her biri için ne yapılacağı.',
  },
];

const faq = [
  {
    q: 'Bu rehberleri okuyup kendim yapabilir miyim?',
    a: 'Evet, öyle olsun diye yazıldılar. Adımları saklamıyoruz. Zorlaşan kısım bilgi değil süreklilik: yorum akışını canlı tutmak, grid üzerinde ne olduğunu görmek ve rakip hareketlerine tepki vermek. Çoğu işletmenin takıldığı yer strateji değil, ritim.',
  },
  {
    q: 'İçerikler ne sıklıkla güncelleniyor?',
    a: 'Google’ın arayüzü ve politikaları değiştikçe. Her sayfada yayın ve güncelleme tarihi yazıyor; eskimiş bir adım görürseniz yazın, düzeltelim.',
  },
  {
    q: 'Neden hepsi Türkçe?',
    a: 'Bu rehberler Türkiye’deki işletmelerin karşılaştığı durumlara göre yazıldı — doğrulama süreçleri, kategori isimleri ve destek akışları ülkeye göre değişiyor. Birebir çevrilmiş bir metin yanlış bilgi verirdi.',
  },
];
---

<ContentLayout
  locale={locale}
  route="guides"
  title="Yerel SEO Rehberleri | Wiserrise"
  description="Google İşletme Profili ve Haritalar sıralaması üzerine uygulamalı rehberler. Profil açma, doğrulama sorunları, yorum artırma ve sıralama yükseltme."
  eyebrow="Rehber"
  h1="Yerel SEO Rehberleri"
  lede="Google İşletme Profili ve Haritalar sıralaması üzerine uygulamalı rehberler. Adımları saklamıyoruz — bu sayfalar kendiniz yapabilesiniz diye yazıldı."
  schemaType="article"
  datePublished="2026-08-01"
  breadcrumb={[{ label: 'Ana Sayfa', href: '/tr' }]}
  faq={faq}
  wideFirst
  related={[
    { label: 'Ücretsiz profil denetimi', href: p('tools/gbp-audit') },
    { label: 'Tüm hizmetler', href: p('services') },
    { label: 'Sektörlere göre yerel SEO', href: p('industries') },
  ]}
  ctaLabel="Ücretsiz Analizimi Al →"
  ctaHref="/tr#contact"
>
  <h2 id="neden">Neden adımları saklamıyoruz?</h2>

  <p>
    Ajans içeriklerinin çoğu sorunu anlatır, çözümü anlatmaz — çözüm için arayın der. Biz
    tersini yapıyoruz: bu sayfalar kendiniz uygulayabilesiniz diye yazıldı ve gerçekten
    yeterli bilgiyi içeriyorlar.
  </p>

  <p>
    Sebebi cömertlik değil, gerçekçilik. Yerel SEO'da bilgi zaten gizli değil; Google'ın
    kendi dokümantasyonu herkese açık. Zorlaşan kısım <strong>süreklilik ve ölçüm</strong>:
    yorum akışını aylarca canlı tutmak, şehrin hangi bölgesinde geride kaldığınızı görmek,
    rakip hareketlerine zamanında tepki vermek. İşletmelerin takıldığı yer neredeyse hiçbir
    zaman "ne yapılacağını bilmemek" olmuyor.
  </p>

  <div class="callout">
    <p>
      <strong>Profilinizin durumunu hemen görmek isterseniz:</strong> okumadan önce
      <a href={p('tools/gbp-audit')}>ücretsiz denetim aracımızı</a> doldurun. 10 soruda hangi
      alanda zayıf olduğunuzu söylüyor, sonra doğrudan ilgili rehbere geçebilirsiniz.
    </p>
  </div>

  <Fragment slot="wide">
    <h2 id="rehberler" class="section-lead">Rehberler</h2>
    <p class="section-lead-sub">
      En sık karşılaştığımız sorunlardan başlayarak.
    </p>
    <CardGrid items={guides} cta="Rehberi oku" />
  </Fragment>

  <Fragment slot="cta">
    <h2>Kendiniz yapmak <span class="highlight">istemiyorsanız</span></h2>
    <p>Ücretsiz analizde profilinizi, sitenizi ve grid sıralamanızı çıkarıp teşhisi yapıyoruz.</p>
  </Fragment>
</ContentLayout>
