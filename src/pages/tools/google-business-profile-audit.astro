---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { routePath } from '../../i18n/routes';
import AuditTool from '../../components/AuditTool.astro';
import { servicePageSchema } from '../../lib/schema';

const locale = 'en' as const;
const p = (key: Parameters<typeof routePath>[1]) => routePath(locale, key);
const url = routePath(locale, 'tools/gbp-audit');

const faq = [
  {
    q: 'Does this tool connect to my profile?',
    a: 'No. Nothing is sent to a server — everything is calculated in your browser. We do not ask for access to your Google account and we do not store your answers.',
  },
  {
    q: 'Does my score guarantee a ranking?',
    a: 'No. This tool measures the structural state of your profile, not your ranking. Ranking also depends on proximity and competition — seeing your real position requires grid measurement laid over the city.',
  },
  {
    q: 'Why don’t you ask for an email at the end?',
    a: 'Because this is not a trap. You see your score and your weak points immediately. Whether you request a free audit afterwards is up to you.',
  },
];

const schema = servicePageSchema({
  locale,
  url,
  name: 'Google Business Profile Audit Tool',
  description:
    'A free tool that scores the local-ranking strengths and weaknesses of your Google Business Profile in 10 questions.',
  faq,
  breadcrumb: [
    { label: 'Home', href: '/' },
    { label: 'Google Business Profile Audit', href: url },
  ],
});
---

<BaseLayout
  locale={locale}
  route="tools/gbp-audit"
  title="Free Google Business Profile Audit | Wiserrise"
  description="Score your profile’s local-ranking weak points in 10 questions. No signup, no email — the result appears instantly in your browser."
>
  <script slot="schema" type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

  <section class="page-hero">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <ol>
          <li><a href="/">Home</a></li>
          <li><span aria-current="page">Profile Audit</span></li>
        </ol>
      </nav>

      <span class="eyebrow">Free tool</span>
      <h1>Google Business Profile Audit</h1>
      <p class="lede">
        See where your profile is strong and where it is weak for local ranking, in 10
        questions. No signup, no email — the calculation runs in your browser and no data
        is sent to us.
      </p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="container">
      <AuditTool locale={locale} ctaHref="/#contact" />

      <div class="prose" style="margin-top:64px;">
        <h2>What this measures — and what it doesn’t</h2>
        <p>
          What it measures is the <strong>structural state</strong> of your profile: category
          accuracy, service structure, review strength, freshness and website connection.
          Together these make up most of the relevance and prominence signals Google weighs
          in local ranking.
        </p>
        <p>
          What it does not measure is <strong>your actual ranking</strong>. Local ranking
          changes with the searcher’s location; a single score cannot represent that. Seeing
          where you place across your city requires a
          <a href={p('services/rank-tracking')}>49-point grid measurement</a> — which is
          included in the free audit.
        </p>

        <h2 id="faq">Frequently asked</h2>
        {faq.map((item) => (
          <details class="faq-item">
            <summary>
              <span>{item.q}</span>
              <div class="faq-icon">+</div>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
