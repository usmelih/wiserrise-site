---
import BaseLayout from '../layouts/BaseLayout.astro';
import { orgSchema } from '../lib/schema';

const locale = 'en' as const;
---

<BaseLayout
  locale={locale}
  route="home"
  title="Wiserrise | Local SEO & Google Maps Growth"
  description="Wiserrise helps local businesses rank higher on Google Maps, outrank nearby competitors, and turn visibility into real leads."
  ogImage="/images/og-image.png"
>
  <script
    slot="schema"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(orgSchema(locale))}
  />

    
   <section class="hero" id="contact">

  <div class="container hero-grid">

    <!-- LEFT -->
     <div class="hero-content">
       
    <div class="user-location">
  <span class="status-dot"></span>
  <span id="userLocation">Loading location...</span>
</div>
   
      <h1>
  Own Your <span class="highlight">City</span><br>
  on <span class="google-font">Google</span>
</h1>

      <p style="font-weight:700;">
        Get into Google Maps Top 3 in 90 days with a focused local SEO system built for real local growth.
      </p>

      <p style="font-size:14px; color:#6F6C64; margin-top:10px;">
        If you're not in the top results, you're losing customers every day.
      </p>

      <div class="hero-newsletter">
        <p class="hero-newsletter-title">
          Sign up below to get <strong>three free tips</strong> you can implement today to start climbing.
        </p>
        <form id="newsletterForm" class="newsletter-form" action="https://app.kit.com/forms/9696115/subscriptions" method="POST">
          <div class="newsletter-row">
            <input type="email" name="email_address" placeholder="name@email.com" required aria-label="Email address">
            <button type="submit" class="btn btn-primary">Subscribe</button>
          </div>
          <label class="newsletter-consent">
            <input type="checkbox" name="consent" required>
            <span>I agree to receive emails from Wiserrise and accept the privacy terms.</span>
          </label>
          <p class="newsletter-status" role="status" aria-live="polite"></p>
        </form>
      </div>

        <div class="client-strip">

  <p class="client-strip-title">
    Businesses working with
  </p>

  <div class="client-logo-marquee">
  <div class="client-logo-track">
    <img src="/images/otoraporbursanilufer.svg" alt="Otorapor Bursa Nilüfer Mudanya Yolu Oto Ekspertiz">
    <img src="/images/mehmet-yucesoy-logo.svg" alt="İzmir Avukat Mehmet Yücesoy Hukuk Bürosu Ceza Avukatı">
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
    <img src="/images/usenmezhukuk.svg" alt="Ankara Avukat Üşenmez Hukuk Bürosu">
    <!-- KOPYA -->
     <img src="/images/otoraporbursanilufer.svg" alt="Otorapor Bursa Nilüfer Mudanya Yolu Oto Ekspertiz">
    <img src="/images/mehmet-yucesoy-logo.svg" alt="İzmir Avukat Mehmet Yücesoy Hukuk Bürosu Ceza Avukatı">
    <img src="/images/erolhukukburosuantalya.svg" alt="Antalya Avukat Alperen Erol">
    <img src="/images/avukatceyhunguvel.svg" alt="Mersin Avukat Ceyhun Güvel Hukuk Bürosu">
    <img src="/images/usenmezhukuk.svg" alt="Ankara Avukat Üşenmez Hukuk Bürosu">
  </div>
</div>
</div>
</div>
    
    <!-- RIGHT: AUDIT FORM -->
   <div class="hero-right">
  <div class="hero-form-card">
    <h3>Get Your <span class="highlight">Free Audit</span></h3>
    <p>Personalized analysis of your Google profile within 24 hours. No costs, no obligations, no sales pitch.</p>

    <form id="applyForm" class="audit-form" action="https://formspree.io/f/mlgpzokq" method="POST">
      <div class="audit-field">
        <label for="auditName">Full Name *</label>
        <input type="text" id="auditName" name="name" required>
      </div>

      <div class="audit-field">
        <label for="auditEmail">Business Email *</label>
        <input type="email" id="auditEmail" name="email" required>
      </div>

      <div class="audit-field">
        <label for="auditPhone">Phone Number *</label>
        <input type="tel" id="auditPhone" name="phone" required>
      </div>

      <div class="form-row">
        <div class="audit-field">
          <label for="auditCompany">Company Name *</label>
          <input type="text" id="auditCompany" name="company" required>
        </div>

        <div class="audit-field">
          <label for="auditCity">City *</label>
          <input type="text" id="auditCity" name="city" required>
        </div>
      </div>

      <div class="audit-field">
        <label for="auditMaps">Your Google Maps URL</label>
        <input type="url" id="auditMaps" name="maps_url" placeholder="https://maps.app.goo.gl/...">
      </div>

      <div class="audit-urgency">
        <span class="audit-urgency-label">By when do you want to solve this problem? *</span>
        <div class="urgency-options">
          <input type="radio" id="urgToday" name="urgency" value="Today" required>
          <label for="urgToday">Today</label>

          <input type="radio" id="urgTomorrow" name="urgency" value="Tomorrow">
          <label for="urgTomorrow">Tomorrow</label>

          <input type="radio" id="urgWeeks" name="urgency" value="In a few weeks">
          <label for="urgWeeks">In a few weeks</label>
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width:100%; border-radius:999px;">Get My Free Audit →</button>
    </form>

    <p class="hero-form-note">We only work with one business per city &amp; industry.</p>
  </div>
</div>
</section>

<section id="positioning" class="reveal">
  <div class="container">
    
    <div class="section-head center">
      <span class="eyebrow">Why Local SEO Matters</span>
      <h2>Most businesses are <span class="highlight">invisible</span>.<br>You don’t have to be.</h2>
      <p>
        When people search for services in your city, they choose from the first few results. 
        If you're not there, you're not even in the conversation.
      </p>
    </div>

    <div class="grid-3">

      <div class="card positioning-card">
        <div class="positioning-icon">
          <div class="icon-shell">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9"/>
              <circle cx="12" cy="12" r="4"/>
              <circle cx="12" cy="12" r="1"/>
            </svg>
          </div>
        </div>

        <h3>High-Intent Traffic</h3>
        <p>
          These aren’t random visitors. They’re people actively looking to buy, call, or book right now.
        </p>
      </div>

      <div class="card positioning-card">
        <div class="positioning-icon">
          <div class="icon-shell">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M3 17l6-6 4 4 7-7"/>
              <path d="M14 5h7v7"/>
            </svg>
          </div>
        </div>

        <h3>Compounding Advantage</h3>
        <p>
          Rankings build momentum over time. Once you're ahead, competitors struggle to catch up.
        </p>
      </div>

      <div class="card positioning-card">
        <div class="positioning-icon">
          <div class="icon-shell">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M2 7l5 3 5-6 5 6 5-3v10H2z"/>
            </svg>
          </div>
        </div>

        <h3>Own Your Market</h3>
        <p>
          When you dominate your city, you become the default choice — not just another option.
        </p>
      </div>

    </div>

  </div>
</section>

<section id="difference-section" class="reveal">
  <div class="container">
    <div class="section-head center">
      <span class="eyebrow">Before & After</span>
      <h2>The Wiserrise <span class="highlight">Difference</span></h2>
      <p>
        A stronger local presence means better rankings, more visibility, and more inbound demand.
      </p>
    </div>

    <div class="difference-wrap">
      <div class="difference-panel">
        <div class="difference-tabs">
          <button class="diff-tab active" data-view="before" type="button">Before</button>
          <button class="diff-tab" data-view="after" type="button">After</button>
        </div>

        <div class="difference-company">
          <div class="difference-company-icon">A</div>
          <div>
            <strong>Your Business</strong>
            <p>Local market visibility snapshot</p>
          </div>
        </div>

        <div id="beforeMetrics" class="difference-metrics active">
          <div class="difference-metric">
            <span>Average Ranking</span>
            <strong class="metric-bad counter" data-value="18">18</strong>
          </div>
          <div class="difference-metric">
            <span>Visibility Share</span>
            <strong class="metric-bad counter percent" data-value="12">12%</strong>
          </div>
          <div class="difference-metric">
            <span>Monthly Calls</span>
            <strong class="metric-bad counter" data-value="9">9</strong>
          </div>
          <div class="difference-metric">
            <span>Monthly Leads</span>
            <strong class="metric-bad counter" data-value="5">5</strong>
          </div>
        </div>

        <div id="afterMetrics" class="difference-metrics">
          <div class="difference-metric">
            <span>Average Ranking</span>
            <strong class="metric-good counter" data-value="3">3</strong>
          </div>
          <div class="difference-metric">
            <span>Visibility Share</span>
            <strong class="metric-good counter percent" data-value="68">68%</strong>
          </div>
          <div class="difference-metric">
            <span>Monthly Calls</span>
            <strong class="metric-good counter" data-value="37">37</strong>
          </div>
          <div class="difference-metric">
            <span>Monthly Leads</span>
            <strong class="metric-good counter" data-value="14">14</strong>
          </div>
        </div>
      </div>

      <div class="difference-visual">
        <div id="beforeVisual" class="difference-map active map-background map--chicago">
          <div class="map-chip">7×7 grid · 49 pts · Chicago, IL</div>
          <div class="map-grid">
            <span class="dot-dred">20+</span><span class="dot-red">20</span><span class="dot-red">19</span><span class="dot-red">18</span><span class="dot-red">19</span><span class="dot-red">20</span><span class="dot-dred">20+</span>
            <span class="dot-red">20</span><span class="dot-red">18</span><span class="dot-orange">15</span><span class="dot-orange">14</span><span class="dot-red">16</span><span class="dot-red">19</span><span class="dot-red">20</span>
            <span class="dot-red">19</span><span class="dot-red">16</span><span class="dot-orange">13</span><span class="dot-orange">12</span><span class="dot-orange">13</span><span class="dot-red">17</span><span class="dot-red">19</span>
            <span class="dot-red">18</span><span class="dot-orange">14</span><span class="dot-orange">12</span><span class="dot-orange">11</span><span class="dot-orange">12</span><span class="dot-orange">15</span><span class="dot-red">18</span>
            <span class="dot-red">19</span><span class="dot-red">16</span><span class="dot-orange">13</span><span class="dot-orange">12</span><span class="dot-orange">14</span><span class="dot-red">17</span><span class="dot-red">19</span>
            <span class="dot-red">20</span><span class="dot-red">18</span><span class="dot-red">16</span><span class="dot-orange">15</span><span class="dot-red">17</span><span class="dot-red">19</span><span class="dot-red">20</span>
            <span class="dot-dred">20+</span><span class="dot-red">20</span><span class="dot-red">19</span><span class="dot-red">18</span><span class="dot-red">19</span><span class="dot-red">20</span><span class="dot-dred">20+</span>
          </div>
          <div class="map-attribution">© OpenStreetMap contributors</div>
        </div>

        <div id="afterVisual" class="difference-map map-background map--chicago">
          <div class="map-chip">7×7 grid · 49 pts · Chicago, IL</div>
          <div class="map-grid">
            <span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">3</span>
            <span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span>
            <span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span>
            <span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span>
            <span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span>
            <span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">3</span><span class="dot-green">1</span><span class="dot-green">1</span>
            <span class="dot-green">1</span><span class="dot-green">3</span><span class="dot-green">1</span><span class="dot-green">1</span><span class="dot-green">2</span><span class="dot-green">1</span><span class="dot-green">2</span>
          </div>
          <div class="map-attribution">© OpenStreetMap contributors</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section id="process" class="reveal">
  <div class="container">

    <!-- HEAD -->
    <div class="section-head reveal delay-1">
      <h2>A simple process that <span class="highlight">Scales</span></h2>
      <p>We keep the workflow tight so improvements happen fast and in the right order.</p>
    </div>

    <div class="process-vertical">

      <div class="process-step reveal delay-2">
        <div class="process-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="2">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
        </div>
        <div class="process-content">
          <p class="process-inline">
            <strong><span>1.</span> Audit</strong>
            We assess your rankings, profile strength, website structure, and competitors.
          </p>
        </div>
      </div>

      <div class="process-step reveal delay-3">
        <div class="process-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="2">
            <path d="M3 17l6-6 4 4 7-7"></path>
            <path d="M14 5h7v7"></path>
          </svg>
        </div>
        <div class="process-content">
          <p class="process-inline">
            <strong><span>2.</span> Strategy</strong>
            We identify the highest-leverage local opportunities and prioritize execution.
          </p>
        </div>
      </div>

      <div class="process-step reveal delay-4">
        <div class="process-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="2">
            <path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"></path>
          </svg>
        </div>
        <div class="process-content">
          <p class="process-inline">
            <strong><span>3.</span> Execution</strong>
            We optimize your assets, improve trust signals, and strengthen ranking relevance.
          </p>
        </div>
      </div>

      <div class="process-step reveal delay-5">
        <div class="process-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#D97757" stroke-width="2">
            <path d="M3 17l6-6 4 4 7-7"></path>
          </svg>
        </div>
        <div class="process-content">
          <p class="process-inline">
            <strong><span>4.</span> Growth</strong>
            You gain stronger visibility, more demand capture, and better local lead flow.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<section id="faq" class="reveal">
  <div class="container">

    <div class="faq-pill-wrap">
      <div class="trust-pill">No contracts. No guesswork.</div>
    </div>

    <div class="section-head">
      <h2>Frequently asked <span class="highlight">Questions</span></h2>
      <p>Clear answers before you book your audit.</p>
    </div>

    <details class="faq-item">
      <summary>
        <span>How long does local SEO take?</span>
        <div class="faq-icon">+</div>
      </summary>
      <p>Most businesses start seeing movement in 4–8 weeks, with stronger results compounding over 3–6 months.</p>
    </details>

    <details class="faq-item">
      <summary>
        <span>Do you only work with one city?</span>
        <div class="faq-icon">+</div>
      </summary>
      <p>No. We can support single-city, multi-city, and multi-location local SEO campaigns depending on your growth model.</p>
    </details>

    <details class="faq-item">
      <summary>
        <span>Do you guarantee rankings?</span>
        <div class="faq-icon">+</div>
      </summary>
      <p>Yes, Top 3 on Google in 90 Days Guaranteed.</p>
    </details>

    <details class="faq-item">
      <summary>
        <span>What do I get in the free audit?</span>
        <div class="faq-icon">+</div>
      </summary>
      <p>You get a clear review of your Google Business Profile, local visibility issues, competitive gaps, and the highest-impact next steps.</p>
    </details>

  </div>
</section>

<section class="cta-mini reveal">
  <div class="container">
    <div class="section-head center">
      <h2>Ready to own your <span class="highlight">City</span>?</h2>
      <p>Get your free audit — here's what happens next:</p>
    </div>

    <ul class="audit-steps">
      <li><span>1</span> We review your Google Business Profile &amp; competitors</li>
      <li><span>2</span> Your personalized analysis lands in your inbox within 24 hours</li>
      <li><span>3</span> You decide — work with us, or keep the roadmap for free</li>
    </ul>

    <div>
      <a href="#contact" class="btn btn-primary">Get My Free Audit →</a>
    </div>
  </div>
</section>
</BaseLayout>
